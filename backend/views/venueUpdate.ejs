<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
<header class="top-row site-header">
    <nav class="navbar navbar-expand navbar-dark container" aria-label="Main navigation">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="https://www.siloon.com/uploads/ueditor/20210204/2-2102041I40W30.png" alt="" width="28" height="28">
        <span>SciFac Events</span>
      </a>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/">Home</a>
        <a class="nav-link" href="/events">Events</a>
        <a class="nav-link" href="/venues">Venues</a>
      </div>
    </nav>
  </header>
  <main class="container py-4">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="mb-3">
          <h4 class="content d-flex align-items-center">
            Edit Venue <button type="submit" form="deleteVenueForm" class="btn btn-danger ms-auto">
              <i class="bi bi-trash me-1"></i> Delete</button>
          </h4>
        </div>
        <form class="card shadow-sm" action="/venue/<%= venue._id %>" method="POST">
          <div class="card body">
            <div class="mb-3">
              <label for="name" class="col-form-label">Name</label>
              <input type="text" name="name" id="name" class="form-control" value="<%= venue.name %>" required>
            </div>
            <div class="mb-3">
              <label for="location" class="col-form-label">Location</label>
              <input type="text" name="location" id="location" class="form-control" value="<%= venue.location %>" required>
            </div>
            <div class="mb-3">
              <label for="capacity" class="col-form-label">Capacity</label>
              <input type="number" name="capacity" id="capacity" class="form-control" value="<%= venue.capacity %>" required>
            </div>
            <div class="mb-3">
              <label for="description" class="col-form-label">Description</label>
              <textarea name="description" id="description" class="form-control"><%= venue.description %></textarea>
            </div>
            <div class="mb-3">
              <label for="facilities" class="form-label d-block">Facilities</label>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="facilities" value="Projector" id="projector" <%= venue.facilities.includes('Projector') ? 'checked' : '' %>>
                <label class="form-check-label" for="projector">Projector</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="facilities" value="Whiteboard" id="whiteboard" <%= venue.facilities.includes('Whiteboard') ? 'checked' : '' %>>
                <label class="form-check-label" for="whiteboard">Whiteboard</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="facilities" value="Microphone" id="microphone" <%= venue.facilities.includes('Microphone') ? 'checked' : '' %>>
                <label class="form-check-label" for="microphone">Microphone</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="facilities" value="WiFi" id="wifi" <%= venue.facilities.includes('WiFi') ? 'checked' : '' %>>
                <label class="form-check-label" for="wifi">WiFi</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="facilities" value="Air Conditioning"
                  id="airConditioning" <%= venue.facilities.includes('Air Conditioning') ? 'checked' : '' %>>
                <label class="form-check-label" for="airConditioning">Air Conditioning</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="facilities" value="Video Conferencing"
                  id="videoConferencing" <%= venue.facilities.includes('Video Conferencing') ? 'checked' : '' %>>
                <label class="form-check-label" for="videoConferencing">Video Conferencing</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="facilities" value="Sound System" id="soundSystem" <%= venue.facilities.includes('Sound System') ? 'checked' : '' %>>
                <label class="form-check-label" for="soundSystem">Sound System</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="facilities" value="Parking" id="parking" <%= venue.facilities.includes('Parking') ? 'checked' : '' %>>
                <label class="form-check-label" for="parking">Parking</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="facilities" value="Wheelchair Access"
                  id="wheelchairAccess" <%= venue.facilities.includes('Wheelchair Access') ? 'checked' : '' %>>
                <label class="form-check-label" for="wheelchairAccess">Wheelchair Access</label>
              </div>
            </div>
            <div class="mb-3">
              <button type="submit" class="btn btn-primary">Save Venue</button>
              <a href="/" class="btn btn-secondary">Cancel</a>
            </div>
          </div>
        </form>
        <form id="deleteVenueForm" action="/venue/delete/<%= venue._id %>" method="POST"
           onsubmit="return confirm('Are you sure you want to delete this venue?');">
        </form>
      </div>
    </div>
  </main>

  <footer class="last-row">
    <p>&copy; 2026 Science Faculty Event Management System. All rights reserved.</p>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
</body>

</html>