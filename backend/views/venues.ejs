<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
<header class="top-row site-header">
    <nav class="navbar navbar-expand navbar-dark container" aria-label="Main navigation">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="https://www.siloon.com/uploads/ueditor/20210204/2-2102041I40W30.png" alt="" width="28" height="28">
        <span>SciFac Events</span>
      </a>
      <div class="navbar-nav ">
        <a class="nav-link" href="/">Home</a>
        <a class="nav-link" href="/events">Events</a>
        <a class="nav-link" href="/venues">Venues</a>
      </div>
    </nav>
  </header>
  <h4 class="content d-flex align-items-center">
    <img src="https://cdn-icons-png.flaticon.com/512/659/659821.png" alt="Calendar Icon" width="25" height="25">
    Facilities & Venues
    <button type="submit" form="addVenueForm" class="btn btn-primary ms-auto">
              <i class="bi bi-trash me-1"></i> Add Venue</button>
  </h4>
  <form id="addVenueForm" action="/venue/add" method="GET"></form>
  <div class="row row-cols-1 row-cols-md-2 row cols-lg-3 g-4">
    <% venues.forEach(function(venue) { %>
      <div class="col">
        <div class="card h-100 shadow-sm venue-card">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= venue.name %></h5>
            <p class="card-text"><strong>Location:</strong> <%= venue.location %></p>
            <p class="card-text"><strong>Capacity:</strong> <%= venue.capacity %></p>
            <% if(venue.facilities && venue.facilities.length) { %>
              <div class="d-flex flex-wrap gap-1 mb-3">
                <% venue.facilities.forEach(function(facility) { %>
                  <span class="badge bg-secondary-subtle text-dark-emphasis"><%= facility %></span>
                <% }); %>
              </div>
            <% } %>
            <p class="card-text"><%= venue.description %></p>
            <a href="/venue/edit/<%= venue._id %>" class="btn btn-primary mt-auto">Edit Venue</a>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

  <footer class="last-row">
    <p>&copy; 2026 Science Faculty Event Management System. All rights reserved.</p>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
</body>

</html>