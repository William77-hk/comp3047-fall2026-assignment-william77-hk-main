<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
  <header class="top-row site-header">
    <nav class="navbar navbar-expand navbar-dark container" aria-label="Main navigation">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="https://www.siloon.com/uploads/ueditor/20210204/2-2102041I40W30.png" alt="" width="28" height="28">
        <span>SciFac Events</span>
      </a>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/">Home</a>
        <a class="nav-link" href="/events">Events</a>
        <a class="nav-link" href="/venues">Venues</a>
      </div>
    </nav>
  </header>

  <main class="detail-container">
    <article class="event-detail-card">
      <% if (event.bannerImage) { %>
        <img src="<%= event.bannerImage %>" alt="<%= event.title %>" class="event-detail-banner">
      <% } else { %>
        <div class="event-detail-banner-placeholder" role="img" aria-label="No banner image available"></div>
      <% } %>
      <div class="event-detail-content">
        <div class="event-detail-badges">
          <% if (event.category) { %>
            <span class="badge text-bg-primary"><%= event.category %></span>
          <% } %>
          <% if (event.status) { %>
            <span class="badge text-bg-success"><%= event.status %></span>
          <% } else if (new Date(event.date).getTime() >= Date.now()) { %>
            <span class="badge text-bg-success">Upcoming</span>
          <% } %>
          <% if (event.isHighlighted === true || event.isHighlighted === 'on' || event.isHighlighted === 'true') { %>
            <span class="badge text-bg-warning"><i class="bi bi-star-fill" aria-hidden="true"></i> Highlighted</span>
          <% } %>
        </div>

        <div class="event-detail-title-row">
          <h1><%= event.title %></h1>
          <a href="/event/edit/<%= event._id %>" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-pencil-fill" aria-hidden="true"></i>
            Edit Event
          </a>
        </div>

        <div class="event-detail-columns">
          <div class="event-detail-description">
            <h2>Description</h2>
            <p><%= event.description || 'No description provided.' %></p>

            <h2>Organizer / Speaker</h2>
            <p class="event-detail-speaker">
              <i class="bi bi-person-fill" aria-hidden="true"></i>
              <%= event.speaker || 'Not specified' %>
            </p>
          </div>

          <aside class="event-detail-info" aria-label="Event details">
            <h2>Event Details</h2>
            <dl>
              <div>
                <dt><i class="bi bi-calendar-event" aria-hidden="true"></i> Date:</dt>
                <dd><%= new Date(event.date).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></dd>
              </div>
              <div>
                <dt><i class="bi bi-people-fill" aria-hidden="true"></i> Capacity:</dt>
                <dd><%= event.capacity %> attendees</dd>
              </div>
              <div>
                <dt><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> Venue:</dt>
                <% if (venue) { %>
                  <dd><a href="/venues"><%= venue.name %></a></dd>
                  <% if (venue.location) { %>
                    <dd class="event-detail-location"><%= venue.location %></dd>
                  <% } %>
                <% } else { %>
                  <dd>Unknown venue</dd>
                <% } %>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </article>
  </main>

  <footer class="last-row detail-footer">
    <p>&copy; 2026 Science Faculty Event Management System. All rights reserved.</p>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
</body>

</html>
