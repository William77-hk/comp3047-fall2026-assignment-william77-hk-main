<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
  <header class="top-row site-header">
    <nav class="navbar navbar-expand navbar-dark container" aria-label="Main navigation">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="https://www.siloon.com/uploads/ueditor/20210204/2-2102041I40W30.png" alt="" width="28" height="28">
        <span>SciFac Events</span>
      </a>
      <div class="navbar-nav ">
        <a class="nav-link" href="/">Home</a>
        <a class="nav-link" href="/events">Events</a>
        <a class="nav-link" href="/venues">Venues</a>
      </div>
    </nav>
  </header>
  <main class="container py-4">
    <section class="mb-5" aria-labelledby="highlighted-heading">
      <% if (highlightedEvents.length) { %>
        <div id="highlightedEventsCarousel" class="carousel slide" data-bs-ride="carousel">
          <div class="carousel-inner">
            <% highlightedEvents.forEach(function(event, index) { %>
              <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                <a href="/event/detail/<%= event._id %>" class="text-decoration-none text-reset">
                  <% if (event.bannerImage) { %>
                    <img src="<%= event.bannerImage %>" class="d-block w-100" alt="<%= event.title %>"
                      style="max-height: 420px; object-fit: cover;">
                  <% } else { %>
                    <div class="bg-primary text-white d-flex align-items-center justify-content-center"
                      style="height: 300px;">
                      <h3><%= event.title %></h3>
                    </div>
                  <% } %>
                  <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded">
                    <h3><%= event.title %></h3>
                    <p><%= new Date(event.date).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></p>
                  </div>
                </a>
              </div>
            <% }); %>
          </div>
          <% if (highlightedEvents.length > 1) { %>
            <button class="carousel-control-prev" type="button" data-bs-target="#highlightedEventsCarousel"
              data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#highlightedEventsCarousel"
              data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
          <% } %>
        </div>
      <% } else { %>
        <p>No highlighted events yet.</p>
      <% } %>
    </section>

    <section class="mb-5" aria-labelledby="recent-heading">
      <h2 id="recent-heading" class="mb-3">
        <img src="https://cdn-icons-png.flaticon.com/512/12711/12711856.png" height="30" width="30">
        Upcoming Events</h2>
      <%- include('partials/eventCards', { events: upcomingEvents }) %>
    </section>

    <section class="mb-5" aria-labelledby="trending-heading">
      <h2 id="trending-heading" class="mb-3">
        <img src="https://static.vecteezy.com/system/resources/thumbnails/075/401/005/small_2x/isolated-blue-flame-illustration-on-white-background-conveys-a-sense-of-cold-heat-with-cool-colors-and-minimalist-design-creating-a-visually-unique-symbol-vector.jpg"
        height="30" width="30">
        Trending Events</h2>
      <%- include('partials/eventCards', { events: trendingEvents }) %>
    </section>

    <section class="mb-5" aria-labelledby="upcoming-heading">
      <h2 id="upcoming-heading" class="mb-3">
        <img src="https://cdn-icons-png.flaticon.com/512/12822/12822792.png" height="30" width="30">
        Most Recent Events</h2>
      <%- include('partials/eventCards', { events: recentEvents }) %>
    </section>
  </main>

  <footer class="last-row">
    <p>&copy; 2026 Science Faculty Event Management System. All rights reserved.</p>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
</body>

</html>