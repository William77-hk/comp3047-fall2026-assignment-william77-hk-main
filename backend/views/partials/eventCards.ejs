<% if (events.length) { %>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% events.forEach(function(event) { %>
      <div class="col">
        <div class="card h-100 shadow-sm">
          <% if (event.bannerImage) { %>
            <img src="<%= event.bannerImage %>" class="card-img-top" alt="<%= event.title %>"
              style="height: 180px; object-fit: cover;">
          <% } %>
          <div class="card-body d-flex flex-column">
            <% if (event.category) { %>
              <span class="home-event-category"><%= event.category %></span>
            <% } %>
            <h3 class="h5 card-title"><%= event.title %></h3>
            <p class="card-text"><strong>Date:</strong> <%= new Date(event.date).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></p>
            <a href="/event/detail/<%= event._id %>" class="btn btn-primary mt-auto">View Details</a>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
<% } else { %>
  <p>No events to show.</p>
<% } %>
